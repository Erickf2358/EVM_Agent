# Copiar a .env y completar antes de desplegar
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com

# Supabase Postgres (session pooler, port 5432 recommended over the 6543 transaction pooler)
# Get the real value from Supabase: Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres
